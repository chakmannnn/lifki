    // =========================
    // STATE
    // =========================
    let currentLang = "en";
    let currentFilter = "all";
    const currentStatuses = new Map();

    // =========================
    // HELPERS
    // =========================
    function esc(text) {
      return String(text).replace(/[&<>"']/g, s => ({
        "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
      })[s]);
    }

    function applyLanguage(lang) {
      currentLang = lang;
      document.documentElement.lang = lang === "ar" ? "ar" : "en";
      document.documentElement.dir = lang === "ar" ? "rtl" : "ltr";
      document.getElementById("langToggle").textContent = lang === "ar" ? "EN" : "العربية";

      document.querySelectorAll("[data-ar][data-en]").forEach(el => {
        el.textContent = el.dataset[lang];
      });

      renderFleet();
      renderReviews();
    }

    function getCardSortRank(statusType) {
      if (statusType === "available") return 0;
      if (statusType === "future") return 1;
      return 2;
    }

    function translatedStatus(status) {
      const type = status?.type || "available";
      const en = status?.textEn || "Available";
      const ar = status?.textAr || "متاح";
      return {
        type,
        text: currentLang === "ar" ? ar : en
      };
    }

    function renderFleet() {
      const grid = document.getElementById("fleetGrid");

      const items = fleet
        .filter(car => currentFilter === "all" ? true : car.category === currentFilter)
        .sort((a, b) => {
          const sa = currentStatuses.get(a.id) || a.status;
          const sb = currentStatuses.get(b.id) || b.status;
          return getCardSortRank(sa.type) - getCardSortRank(sb.type);
        });

      grid.innerHTML = items.map(car => {
        const status = translatedStatus(currentStatuses.get(car.id) || car.status);
        const name = currentLang === "ar" ? car.nameAr : car.nameEn;
        const drive = currentLang === "ar" ? car.driveAr : car.driveEn;
        const passengers = currentLang === "ar" ? car.passengersAr : car.passengersEn;
        const price = currentLang === "ar" ? car.priceAr : car.priceEn;

        return `
          <article class="car-card" data-category="${esc(car.category)}">
            <div class="car-visual">
              <img src="${esc(car.image)}" alt="${esc(name)}" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
              <div style="display:none; place-items:center; width:100%; min-height:170px; color:#7c7c8a; font-weight:800; text-align:center;">
                ${esc(name)}<br><span style="font-weight:600">${currentLang === 'ar' ? 'ضع صورة .webp جانبية شفافة هنا' : 'Place a transparent side-view .webp here'}</span>
              </div>
            </div>
            <div class="car-body">
              <div class="car-top">
                <div>
                  <h3 class="car-name">${esc(name)}</h3>
                  <p class="car-meta">${esc(drive)} · ${esc(passengers)}</p>
                </div>
                <div class="price">${esc(price)}</div>
              </div>
              <span class="status ${esc(status.type)}">${esc(status.text)}</span>
            </div>
          </article>
        `;
      }).join("");

      if (!items.length) {
        grid.innerHTML = `<p class="section-subtitle">${currentLang === 'ar' ? 'لا توجد سيارات ضمن هذا التصنيف.' : 'No cars in this category.'}</p>`;
      }
    }

    function renderReviews() {
      const track = document.getElementById("reviewsTrack");
      track.innerHTML = reviews.map(r => `
        <article class="review-card">
          <div class="review-head">
            <div class="reviewer">
              <div class="avatar">${esc((currentLang === "ar" ? r.nameAr : r.nameEn).slice(0,1))}</div>
              <div>
                <h4>${esc(currentLang === "ar" ? r.nameAr : r.nameEn)}</h4>
                <p>${esc(r.rating)} / 5</p>
              </div>
            </div>
            <div class="stars">★★★★★</div>
          </div>
          <p class="review-text">${esc(currentLang === "ar" ? r.textAr : r.textEn)}</p>
          <div class="review-car">${esc(currentLang === "ar" ? r.carAr : r.carEn)}</div>
        </article>
      `).join("");
    }

    async function fetchStatusesFromGoogle() {
  const calendarIds = fleet.map(car => car.calendarId).join(",");

  const url = `${APPS_SCRIPT_URL}?calendarIds=${encodeURIComponent(calendarIds)}`;

  console.log("Fetching via GET:", url);

  try {
    const response = await fetch(url);

    const data = await response.json();

    data.items.forEach(item => {
      const car = fleet.find(x => x.calendarId === item.calendarId);
      if (!car) return;

      currentStatuses.set(car.id, {
        type: item.status,
        textEn: item.labelEn,
        textAr: item.labelAr
      });
    });

    renderFleet();

  } catch (error) {
    console.error("Fetch failed:", error);
  }
}
    
    function bindFleetFilters() {
      document.getElementById("fleetFilters").addEventListener("click", (e) => {
        const btn = e.target.closest("[data-filter]");
        if (!btn) return;

        currentFilter = btn.dataset.filter;
        document.querySelectorAll("#fleetFilters .chip").forEach(c => c.classList.toggle("active", c === btn));
        renderFleet();
      });
    }

    function bindReviewNext() {
      const track = document.getElementById("reviewsTrack");
      document.getElementById("reviewNext").addEventListener("click", () => {
        track.scrollBy({ left: track.clientWidth * 0.85, behavior: "smooth" });
      });
    }

    function bindFloatingActions() {
      document.getElementById("whatsappFloat").href = `https://wa.me/${WHATSAPP_NUMBER}`;
      document.getElementById("callFloat").href = `tel:${PHONE_NUMBER}`;
      document.getElementById("callToBookTop").href = `tel:${PHONE_NUMBER}`;
    }

    function bindLogoUploadPlaceholder() {
      const img = document.getElementById("logoImage");
      const fallback = document.getElementById("logoFallback");
      img.addEventListener("load", () => {
        img.style.display = "block";
        fallback.style.display = "none";
      });
      img.addEventListener("error", () => {
        img.style.display = "none";
        fallback.style.display = "grid";
      });
    }

    // =========================
    // INIT
    // =========================
    document.getElementById("langToggle").addEventListener("click", () => {
      applyLanguage(currentLang === "en" ? "ar" : "en");
    });

    bindFleetFilters();
    bindReviewNext();
    bindFloatingActions();
    bindLogoUploadPlaceholder();
    applyLanguage("en");
    renderFleet();
    renderReviews();
    fetchStatusesFromGoogle();
