<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Saudi Car Rental Landing Page</title>
  <meta name="description" content="Modern Saudi car rental landing page with live availability, fleet filters, reviews, and direct booking actions." />
  <style>
    :root{
      --bg:#ffffff;
      --surface:rgba(255,255,255,.78);
      --surface-strong:#ffffff;
      --text:#172033;
      --muted:#667085;
      --line:rgba(23,32,51,.10);
      --shadow:0 18px 50px rgba(15,23,42,.10);
      --shadow-soft:0 10px 30px rgba(15,23,42,.08);
      --pink:#f4a8d6;
      --purple:#8b5cf6;
      --purple-2:#b58cff;
      --gold:#f4b400;
      --green:#16a34a;
      --yellow:#f59e0b;
      --red:#ef4444;
      --radius:22px;
      --radius-sm:16px;
      --max:1180px;
      --header-h:82px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      color:var(--text);
      background:
        radial-gradient(1200px 600px at 10% 0%, rgba(244,168,214,.18), transparent 55%),
        radial-gradient(900px 500px at 90% 10%, rgba(139,92,246,.14), transparent 50%),
        var(--bg);
      overflow-x:hidden;
    }

    img{max-width:100%;display:block}
    a{text-decoration:none;color:inherit}
    button{font:inherit}
    .container{width:min(var(--max), calc(100% - 32px)); margin:0 auto;}
    .section{padding:88px 0}
    .section-title{
      font-size:clamp(28px,4vw,48px);
      line-height:1.05;
      margin:0 0 10px;
      letter-spacing:-.04em;
    }
    .section-subtitle{
      margin:0;
      color:var(--muted);
      max-width:720px;
      line-height:1.7;
      font-size:16px;
    }

    /* Header */
    .site-header{
      position:fixed;
      inset:0 0 auto 0;
      z-index:1000;
      backdrop-filter:blur(18px);
      background:rgba(255,255,255,.55);
      border-bottom:1px solid rgba(255,255,255,.55);
    }
    .header-inner{
      height:var(--header-h);
      display:flex;
      align-items:center;
      gap:16px;
    }
    .logo{
      display:flex;
      align-items:center;
      gap:12px;
      min-width:160px;
      font-weight:800;
      letter-spacing:-.04em;
    }
    .logo-mark{
      width:42px;height:42px;border-radius:14px;
      background:linear-gradient(135deg, var(--pink), var(--purple));
      box-shadow:0 10px 25px rgba(139,92,246,.25);
      overflow:hidden;
      display:grid;place-items:center;
      color:#fff;
      font-weight:800;
    }
    .logo img{
      width:42px;height:42px;object-fit:contain;border-radius:14px;
      display:none;
    }
    .nav-spacer{flex-grow:1}
    .desktop-links{
      display:flex;
      align-items:center;
      gap:14px;
      flex-wrap:wrap;
    }
    .desktop-links a{
      color:var(--text);
      font-weight:600;
      padding:10px 12px;
      border-radius:999px;
      transition:.2s ease;
    }
    .desktop-links a:hover{background:rgba(139,92,246,.08)}
    .lang-btn{
      border:1px solid rgba(139,92,246,.18);
      background:rgba(255,255,255,.72);
      color:var(--text);
      padding:11px 14px;
      border-radius:999px;
      font-weight:700;
      box-shadow:0 8px 24px rgba(15,23,42,.04);
      cursor:pointer;
      white-space:nowrap;
    }

    .mobile-nav{
      display:none;
      border-top:1px solid rgba(15,23,42,.06);
      background:rgba(255,255,255,.82);
      overflow-x:auto;
      scrollbar-width:none;
    }
    .mobile-nav::-webkit-scrollbar{display:none}
    .mobile-nav .scroll{
      display:flex;
      gap:10px;
      padding:10px 16px 12px;
      min-width:max-content;
    }
    .mobile-nav a{
      flex:0 0 auto;
      padding:10px 14px;
      border-radius:999px;
      background:rgba(139,92,246,.08);
      border:1px solid rgba(139,92,246,.10);
      font-weight:700;
      white-space:nowrap;
    }

    main{padding-top:var(--header-h)}

    /* Hero */
    .hero{
      position:relative;
      min-height:100vh;
      display:grid;
      align-items:center;
      background:
        linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.05)),
        url("https://www.google.com/maps/place/%D9%84%D8%A7%D9%8A%D9%86+%D9%83%D8%A7%D8%B1+Line+Car%E2%80%AD/@24.7959358,46.7292764,3a,75y,90t/data=!3m8!1e2!3m6!1sAF1QipMkCsOT4BARNOjskqLWsE0GViC_OIVuXk7xuvCT!2e10!3e12!6shttps:%2F%2Flh3.googleusercontent.com%2Fp%2FAF1QipMkCsOT4BARNOjskqLWsE0GViC_OIVuXk7xuvCT%3Dw203-h178-k-no!7i3378!8i2978!4m11!1m2!2m1!1sLINECAR+RIYADH!3m7!1s0x3e2efdca7aeb22ad:0x89dcb0dd2522c9d1!8m2!3d24.7960672!4d46.7292087!10e5!15sCg5MSU5FQ0FSIFJJWUFESFoQIg5saW5lY2FyIHJpeWFkaJIBEWNhcl9yZW50YWxfYWdlbmN5mgEjQ2haRFNVaE5NRzluUzBWSlEwRm5TVVIyWjNOeVkyWlJFQUXgAQD6AQUIyQEQHA!16s%2Fg%2F11sccz2g1b?entry=ttu&g_ep=EgoyMDI2MDUwMi4wIKXMDSoASAFQAw%3D%3D#") center/cover no-repeat;
    }
    .hero::before{
      content:"";
      position:absolute;inset:0;
      background:linear-gradient(90deg, rgba(255,255,255,.30) 0%, rgba(255,255,255,.20) 42%, rgba(255,255,255,.05) 100%);
    }
    .hero-inner{
      position:relative;
      z-index:1;
      padding:64px 0 120px;
      display:grid;
      gap:24px;
      max-width:760px;
    }
    .hero-kicker{
      display:inline-flex;
      width:max-content;
      align-items:center;
      gap:8px;
      padding:8px 12px;
      border-radius:999px;
      background:rgba(255,255,255,.72);
      border:1px solid rgba(139,92,246,.14);
      box-shadow:var(--shadow-soft);
      color:var(--purple);
      font-weight:700;
      font-size:14px;
    }
    .hero-title{
      font-size:clamp(38px,6vw,72px);
      line-height:1.02;
      letter-spacing:-.06em;
      margin:0;
      max-width:11ch;
    }
    .hero-desc{
      margin:0;
      max-width:62ch;
      color:#3c4459;
      line-height:1.75;
      font-size:17px;
    }
    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      align-items:center;
    }
    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      padding:14px 20px;
      border-radius:999px;
      font-weight:800;
      transition:.2s ease;
      border:1px solid transparent;
      cursor:pointer;
    }
    .btn-primary{
      background:linear-gradient(135deg, var(--purple), var(--pink));
      color:#fff;
      box-shadow:0 14px 30px rgba(139,92,246,.20);
    }
    .btn-primary:hover{transform:translateY(-1px)}
    .btn-ghost{
      background:rgba(255,255,255,.78);
      border-color:rgba(139,92,246,.18);
      color:var(--text);
      box-shadow:var(--shadow-soft);
    }
    .hero-note{
      margin:4px 0 0;
      color:var(--muted);
      font-size:14px;
      font-weight:600;
    }

    /* Floating booking process */
    .process-wrap{
      position:relative;
      margin-top:-62px;
      z-index:3;
    }
    .process-grid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0,1fr));
      gap:16px;
    }
    .process-card{
      background:rgba(255,255,255,.84);
      border:1px solid rgba(139,92,246,.12);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      padding:22px;
      display:flex;
      gap:14px;
      align-items:flex-start;
      min-height:118px;
    }
    .process-num{
      width:40px;height:40px;border-radius:14px;
      display:grid;place-items:center;
      background:linear-gradient(135deg, rgba(244,168,214,.28), rgba(139,92,246,.18));
      color:var(--purple);
      font-weight:900;
      flex:0 0 auto;
    }
    .process-card h3{
      margin:2px 0 6px;
      font-size:18px;
      line-height:1.2;
    }
    .process-card p{
      margin:0;
      color:var(--muted);
      line-height:1.65;
      font-size:14px;
    }

    /* Fleet */
    .fleet-head{
      display:flex;
      align-items:end;
      justify-content:space-between;
      gap:20px;
      margin-bottom:22px;
    }
    .chips{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin:22px 0 28px;
    }
    .chip{
      border:1px solid rgba(139,92,246,.16);
      background:rgba(255,255,255,.80);
      color:var(--text);
      padding:10px 16px;
      border-radius:999px;
      font-weight:700;
      cursor:pointer;
      transition:.2s ease;
    }
    .chip.active{
      background:linear-gradient(135deg, rgba(139,92,246,.12), rgba(244,168,214,.20));
      border-color:rgba(139,92,246,.22);
      color:var(--purple);
    }

    .fleet-grid{
      display:grid;
      grid-template-columns:repeat(3, minmax(0,1fr));
      gap:18px;
    }
    .car-card{
      background:rgba(255,255,255,.88);
      border:1px solid rgba(15,23,42,.07);
      border-radius:26px;
      box-shadow:var(--shadow);
      overflow:hidden;
      display:grid;
      grid-template-rows:auto auto 1fr;
      min-height:100%;
    }
    .car-visual{
      position:relative;
      padding:18px 18px 8px;
      background:
        radial-gradient(ellipse at center bottom, rgba(15,23,42,.16), transparent 55%),
        linear-gradient(180deg, rgba(139,92,246,.05), rgba(244,168,214,.03));
      min-height:220px;
      display:grid;
      place-items:end center;
    }
    .car-visual img{
      width:min(100%, 360px);
      height:auto;
      object-fit:contain;
      filter:drop-shadow(0 18px 16px rgba(15,23,42,.16));
      transform:translateY(8px);
    }
    .car-body{
      padding:18px;
      display:grid;
      gap:10px;
    }
    .car-top{
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
    }
    .car-name{
      margin:0;
      font-size:20px;
      line-height:1.1;
      letter-spacing:-.03em;
    }
    .car-meta{
      margin:4px 0 0;
      color:var(--muted);
      font-size:13px;
      line-height:1.5;
    }
    .price{
      font-weight:900;
      color:var(--purple);
      white-space:nowrap;
      font-size:18px;
    }
    .status{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:9px 12px;
      border-radius:999px;
      font-size:13px;
      font-weight:800;
      width:max-content;
    }
    .status::before{
      content:"";
      width:9px;height:9px;border-radius:50%;
      background:currentColor;
      box-shadow:0 0 0 4px rgba(0,0,0,.04);
    }
    .status.available{color:var(--green); background:rgba(22,163,74,.09)}
    .status.future{color:var(--yellow); background:rgba(245,158,11,.12)}
    .status.busy{color:var(--red); background:rgba(239,68,68,.11)}

    /* Reviews */
    .reviews-shell{
      background:linear-gradient(180deg, rgba(139,92,246,.04), rgba(255,255,255,.92));
      border-top:1px solid rgba(139,92,246,.08);
      border-bottom:1px solid rgba(139,92,246,.08);
    }
    .reviews-top{
      display:flex;
      justify-content:space-between;
      gap:16px;
      align-items:end;
      margin-bottom:24px;
    }
    .review-summary{
      display:flex;
      align-items:center;
      gap:14px;
      flex-wrap:wrap;
      color:var(--text);
      margin-top:10px;
    }
    .digital{
      font-variant-numeric:tabular-nums;
      font-weight:900;
      font-size:20px;
      letter-spacing:.02em;
    }
    .stars{
      color:var(--gold);
      letter-spacing:1px;
      font-size:18px;
    }
    .reviews-rail{
      display:grid;
      grid-template-columns:1fr auto;
      gap:10px;
      align-items:center;
    }
    .reviews-track{
      display:grid;
      grid-auto-flow:column;
      grid-auto-columns:minmax(320px, 360px);
      gap:16px;
      overflow-x:auto;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
      padding-bottom:8px;
    }
    .reviews-track::-webkit-scrollbar{display:none}
    .review-card{
      scroll-snap-align:start;
      background:rgba(255,255,255,.88);
      border:1px solid rgba(15,23,42,.07);
      border-radius:24px;
      box-shadow:var(--shadow-soft);
      padding:20px;
      min-height:210px;
      display:grid;
      gap:12px;
    }
    .review-head{
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:center;
    }
    .reviewer{
      display:flex;
      gap:12px;
      align-items:center;
    }
    .avatar{
      width:44px;height:44px;border-radius:16px;
      background:linear-gradient(135deg, rgba(244,168,214,.45), rgba(139,92,246,.28));
      display:grid;place-items:center;
      font-weight:900;
      color:var(--purple);
    }
    .reviewer h4{
      margin:0 0 2px;
      font-size:15px;
    }
    .reviewer p{
      margin:0;
      color:var(--muted);
      font-size:13px;
    }
    .review-text{
      margin:0;
      color:#2f3747;
      line-height:1.75;
      font-size:14px;
    }
    .review-car{
      margin-top:auto;
      color:var(--purple);
      font-size:13px;
      font-weight:700;
    }
    .review-next{
      border:1px solid rgba(139,92,246,.16);
      background:#fff;
      border-radius:999px;
      width:46px;height:46px;
      display:grid;place-items:center;
      box-shadow:var(--shadow-soft);
      cursor:pointer;
    }

    /* Footer */
    .footer{
      padding:72px 0 34px;
    }
    .footer-grid{
      display:grid;
      grid-template-columns:1.3fr .8fr .9fr;
      gap:20px;
    }
    .footer-block{
      background:rgba(255,255,255,.88);
      border:1px solid rgba(15,23,42,.07);
      border-radius:26px;
      box-shadow:var(--shadow-soft);
      overflow:hidden;
    }
    .footer-map iframe{
      width:100%;
      height:100%;
      min-height:320px;
      border:0;
      display:block;
    }
    .footer-content{
      padding:22px;
      display:grid;
      gap:12px;
    }
    .footer-content h3{
      margin:0 0 8px;
      font-size:20px;
    }
    .footer-link{
      color:var(--text);
      font-weight:600;
      line-height:1.7;
    }
    .footer-muted{color:var(--muted); line-height:1.7; margin:0}
    .mini-list{display:grid; gap:8px}
    .footer-bottom{
      padding-top:18px;
      color:var(--muted);
      font-size:13px;
      text-align:center;
    }

    /* Floating action bar */
    .floating-actions{
      position:fixed;
      right:18px;
      bottom:18px;
      z-index:1200;
      display:flex;
      gap:10px;
      background:rgba(255,255,255,.78);
      border:1px solid rgba(15,23,42,.08);
      box-shadow:var(--shadow);
      border-radius:999px;
      padding:10px;
      backdrop-filter:blur(14px);
    }
    .fab{
      width:48px;height:48px;
      border-radius:50%;
      display:grid;place-items:center;
      font-weight:900;
      color:#fff;
    }
    .fab.whatsapp{background:#25d366}
    .fab.call{background:linear-gradient(135deg, var(--purple), var(--pink))}
    .fab svg{width:22px;height:22px;fill:currentColor}

    /* Utilities */
    .sr-only{
      position:absolute;
      width:1px;height:1px;
      padding:0;margin:-1px;overflow:hidden;
      clip:rect(0,0,0,0);white-space:nowrap;border:0;
    }

    /* RTL */
    html[dir="rtl"] body{direction:rtl}
    html[dir="rtl"] .header-inner,
    html[dir="rtl"] .fleet-head,
    html[dir="rtl"] .reviews-top,
    html[dir="rtl"] .review-head{direction:rtl}

    /* Responsive */
    @media (max-width: 1024px){
      .fleet-grid{grid-template-columns:repeat(2, minmax(0,1fr))}
      .footer-grid{grid-template-columns:1fr}
      .footer-map iframe{min-height:280px}
      .process-grid{grid-template-columns:1fr}
      .hero-title{max-width:12ch}
    }
    @media (max-width: 768px){
      :root{--header-h:70px}
      .desktop-links{display:none}
      .mobile-nav{display:block}
      .hero{
        min-height:92vh;
        background-position:center right;
      }
      .hero::before{
        background:linear-gradient(180deg, rgba(255,255,255,.72) 0%, rgba(255,255,255,.74) 30%, rgba(255,255,255,.52) 100%);
      }
      .hero-inner{padding:34px 0 118px}
      .fleet-grid{grid-template-columns:1fr}
      .reviews-rail{grid-template-columns:1fr}
      .review-next{justify-self:start}
      .container{width:min(var(--max), calc(100% - 24px))}
      .section{padding:72px 0}
    }
  </style>
</head>
<body>

  <header class="site-header">
    <div class="container">
      <div class="header-inner">
        <a class="logo" href="#top" aria-label="Home">
          <span class="logo-mark">
            <img id="logoImage" alt="Agency logo" />
            <span id="logoFallback">LC</span>
          </span>
          <span data-ar="لينكار" data-en="LineCar" id="logoText">LineCar</span>
        </a>

        <div class="nav-spacer"></div>

        <nav class="desktop-links" aria-label="Quick links">
          <a href="#fleet" data-ar="أسطولنا" data-en="Our Fleet">Our Fleet</a>
          <a href="#about" data-ar="من نحن" data-en="About Us">About Us</a>
        </nav>

        <button class="lang-btn" id="langToggle" type="button">العربية</button>
      </div>
    </div>

    <nav class="mobile-nav" aria-label="Mobile quick links">
      <div class="scroll">
        <a href="#fleet" data-ar="أسطولنا" data-en="Our Fleet">Our Fleet</a>
        <a href="#about" data-ar="من نحن" data-en="About Us">About Us</a>
        <a href="#reviews" data-ar="التقييمات" data-en="Reviews">Reviews</a>
        <a href="#contact" data-ar="التواصل" data-en="Contact">Contact</a>
      </div>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container">
        <div class="hero-inner">
          <div class="hero-kicker" data-ar="نظام توفر مباشر" data-en="Live availability system">Live availability system</div>

          <h1 class="hero-title" data-ar="استأجر سيارتك في السعودية بثقة" data-en="Rent your car in Dammam with confidence">
            Rent your car in Saudi Arabia with confidence
          </h1>

          <p class="hero-desc" data-ar="اختيار سريع، توفر مباشر، واتصال فوري للحجز.." data-en="Fast selection, live availability, and instant booking contact.">
            Fast selection, live availability, and instant booking contact.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#fleet" data-ar="اختر سيارتك" data-en="Choose Your Car">Choose Your Car</a>
            <a class="btn btn-ghost" id="callToBookTop" href="tel:+966500000000" data-ar="اتصل للحجز" data-en="Call to Book">Call to Book</a>
          </div>
    </section>

    <section class="process-wrap">
      <div class="container">
        <div class="process-grid">
          <article class="process-card">
            <div class="process-num">1</div>
            <div>
              <h3 data-ar="اختر سيارتك" data-en="Choose your car">Choose your car</h3>
              <p data-ar="يعرض النظام الحالة الحالية والتواريخ القادمة لكل سيارة." data-en="The system shows the current status and upcoming dates for each car.">The system shows the current status and upcoming dates for each car.</p>
            </div>
          </article>

          <article class="process-card">
            <div class="process-num">2</div>
            <div>
              <h3 data-ar="اتصل أو أرسل لنا على واتساب للحجز" data-en="Call or text us via WhatsApp to book">Call or text us via WhatsApp to book</h3>
              <p data-ar="تواصل مباشرة لتأكيد الحجز بشكل سريع." data-en="Contact us directly to confirm your booking quickly.">Contact us directly to confirm your booking quickly.</p>
            </div>
          </article>

          <article class="process-card">
            <div class="process-num">3</div>
            <div>
              <h3 data-ar="استمتع برحلتك" data-en="Enjoy your ride">Enjoy your ride</h3>
              <p data-ar="استلام مرن وتجربة حجز سهلة ومباشرة." data-en="Flexible pickup and a simple booking experience.">Flexible pickup and a simple booking experience.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="fleet">
      <div class="container">
        <div class="fleet-head">
